#!/bin/bash

set -e

cd $(git rev-parse --show-toplevel)

src=html
dest=/var/www/pcheng.cc
export TEMPLATE_DIR=templates

ln -s $dest -T output || true
find -L output -mindepth 1 -delete || true

for file in $(find $src -type f); do
    out_file=${file/#$src/$dest}
    mkdir -p $(dirname $out_file)

    if [[ $file =~ .*\.temp$ ]]; then
        out_file=${out_file%.temp}.html
        echo "Parsing $file -> $out_file"
        scripts/parse-file $file > $out_file
    else
        echo "Linking $file -> $out_file"
        ln $file $out_file
    fi
done

for dir in res styles; do
    echo "Recursively linking dir $dir"
    cp -al $PWD/$dir $dest/$dir
done
